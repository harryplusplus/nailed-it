{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mitm",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/mitmweb",
      "args": [
        "--mode=reverse:https://crof.ai",
        "--no-web-open-browser",
        "-s",
        "${workspaceFolder}/python-packages/mitm/src/mitm/main.py"
      ],
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
